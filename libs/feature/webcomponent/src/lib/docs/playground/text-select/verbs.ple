sandbox = "node"

// En mode « units », seuls les morceaux entre accolades sont sélectionnables.
// Ils sont numérotés à partir de 0 dans l'ordre du texte.
texte = :wc-text-select
texte.mode = "units"

builder == #!lang=js
const phrase = [
  ['Le', false], ['chat', false], ['dort', true], ['pendant', false], ['que', false],
  ['les', false], ['enfants', false], ['jouent', true], ['et', false], ['chantent', true]
]
texte.text = phrase.map(([mot]) => '{' + mot + '}').join(' ') + '.'
verbes = phrase.map(([, estVerbe], i) => (estVerbe ? i : -1)).filter((i) => i >= 0)
==

title ==
Repérer les verbes
==

statement ==
Cliquez sur tous les **verbes conjugués** de la phrase. Cliquez de nouveau sur un mot pour le désélectionner.
==

form ==
{{ texte }}
==

grader == #!lang=js
// texte.selections : [{ position, content }] où position est le numéro du morceau sélectionné.
const choisis = texte.selections.map((s) => s.position)
const justes = choisis.filter((p) => verbes.includes(p)).length
const fausses = choisis.length - justes

texte.selections.forEach((s) => {
  s.css = verbes.includes(s.position) ? 'success-state' : 'error-state'
})

grade = Math.max(0, Math.round((100 * (justes - fausses)) / verbes.length))
feedback.type = grade === 100 ? 'success' : 'error'
feedback.content = `${justes} verbe(s) trouvé(s) sur ${verbes.length}, ${fausses} sélection(s) erronée(s).`
==
