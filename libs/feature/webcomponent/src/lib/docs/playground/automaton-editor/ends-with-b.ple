sandbox = "node"

// L'éditeur d'automate démarre vide : l'apprenant dessine ses états et ses transitions.
automate = :wc-automaton-editor
automate.height = 400

title ==
Automate : mots terminant par « b »
==

statement ==
Dessinez un automate fini qui reconnaît **exactement** les mots de l'alphabet `{a, b}` qui se terminent par la lettre `b`.

- Double-cliquez dans la zone pour créer un état.
- Reliez deux états pour créer une transition. Elle porte d'abord le symbole `$`, qui désigne une transition ε (sans lecture de lettre) : utilisez son menu « Changer étiquette » pour saisir son ou ses symboles, séparés par des virgules.
- Utilisez le menu d'un état pour le rendre initial ou acceptant.
==

form ==
{{ automate }}
==

grader == #!lang=js
// Le grader reçoit l'automate au format objet :
// { states, alphabet, initialStates, acceptingStates, transitions: [{ fromState, toState, symbols }] }
// Une transition ε (sans lecture de lettre) a pour symbole `$` : c'est le symbole d'une
// transition qui vient d'être tracée, tant que l'apprenant ne l'a pas modifié.
const EPSILON = '$'
const a = automate.automaton || {}
const transitions = a.transitions || []

// Ajoute aux états ceux que l'on atteint par des transitions ε.
function fermeture(etats) {
  const atteints = new Set(etats)
  const aVisiter = [...atteints]
  while (aVisiter.length) {
    const etat = aVisiter.pop()
    for (const t of transitions) {
      if (t.fromState === etat && (t.symbols || []).includes(EPSILON) && !atteints.has(t.toState)) {
        atteints.add(t.toState)
        aVisiter.push(t.toState)
      }
    }
  }
  return atteints
}

// Simule l'automate (éventuellement non déterministe, avec transitions ε) sur un mot.
function accepte(mot) {
  let courants = fermeture(a.initialStates || [])
  for (const lettre of mot) {
    const suivants = []
    for (const t of transitions) {
      if (courants.has(t.fromState) && (t.symbols || []).includes(lettre)) {
        suivants.push(t.toState)
      }
    }
    courants = fermeture(suivants)
  }
  return [...courants].some((etat) => (a.acceptingStates || []).includes(etat))
}

// Jeu de tests : tous les mots de longueur 0 à 5 sur {a, b}.
const mots = ['']
for (let n = 1; n <= 5; n++) {
  for (let i = 0; i < 2 ** n; i++) {
    mots.push(i.toString(2).padStart(n, '0').replace(/0/g, 'a').replace(/1/g, 'b'))
  }
}

const dansLeLangage = (mot) => mot.endsWith('b')
const erreurs = mots.filter((mot) => accepte(mot) !== dansLeLangage(mot))

// Proportion de mots bien traités parmi ceux du langage (à accepter) et parmi les autres
// (à rejeter). La note est la plus faible des deux : un automate qui accepte tout, ou qui
// rejette tout, obtient 0 au lieu de la moitié des points.
function reussite(attendu) {
  const groupe = mots.filter((mot) => dansLeLangage(mot) === attendu)
  return groupe.filter((mot) => accepte(mot) === attendu).length / groupe.length
}

if (!(a.initialStates || []).length) {
  grade = 0
  feedback.type = 'warning'
  feedback.content = "Votre automate n'a pas d'état initial."
} else if (erreurs.length === 0) {
  grade = 100
  feedback.type = 'success'
  feedback.content = 'Bravo, votre automate reconnaît exactement le langage demandé.'
} else {
  grade = Math.floor(100 * Math.min(reussite(true), reussite(false)))
  const exemples = erreurs.slice(0, 3).map((m) => '`' + (m || 'ε') + '`').join(', ')
  feedback.type = 'error'
  feedback.content = `Votre automate se trompe sur ${erreurs.length} mot(s) testé(s), par exemple : ${exemples}.`
}
==

solution ==
Deux états suffisent : `q0` (initial) et `q1` (acceptant).
Depuis chaque état, la lettre `a` mène à `q0` et la lettre `b` mène à `q1`.
==
