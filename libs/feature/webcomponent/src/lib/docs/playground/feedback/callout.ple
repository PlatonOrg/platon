sandbox = "node"

// wc-feedback affiche un encadré coloré (success, info, warning ou error) au contenu markdown.
// Il peut être placé dans l'énoncé, le formulaire ou la solution.
rappel = :wc-feedback
rappel.type = "info"
rappel.content = "**Rappel** : l'aire d'un rectangle est le produit de sa longueur par sa largeur."

attention = :wc-feedback
attention.type = "warning"
attention.content = "Donnez votre réponse en **cm²**, sans unité."

reponse = :wc-input-box
reponse.type = "number"

builder == #!lang=js
longueur = 3 + Math.floor(Math.random() * 10)
largeur = 2 + Math.floor(Math.random() * 5)
==

title ==
Encadrés d'information
==

statement ==
{{ rappel }}

Un rectangle mesure {{ longueur }} cm de long et {{ largeur }} cm de large. Quelle est son aire ?

{{ attention }}
==

form ==
{{ reponse }}
==

grader == #!lang=js
const aire = longueur * largeur

// Les modifications d'un widget sont conservées d'une soumission à l'autre :
// on remet l'encadré dans son état initial pour qu'une ancienne alerte ne reste pas affichée.
attention.type = 'warning'
attention.content = 'Donnez votre réponse en **cm²**, sans unité.'

if (Number(reponse.value) === aire) {
  grade = 100
  feedback.type = 'success'
  feedback.content = 'Exact !'
} else {
  grade = 0
  feedback.type = 'error'
  feedback.content = 'Ce n\'est pas la bonne aire.'
  // Un widget peut aussi être modifié par le grader : ici l'encadré de l'énoncé devient une alerte.
  attention.type = 'error'
  attention.content = `Vous avez répondu ${reponse.value}. Vérifiez que vous avez multiplié (et non additionné) les deux dimensions.`
}
==
