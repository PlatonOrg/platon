grader == #!lang=py
if qcm.get("selection") == str(bonne):
    grade = 100
    feedback["type"] = "success"
    feedback["content"] = "Bonne réponse !"
else:
    grade = 0
    feedback["type"] = "error"
    feedback["content"] = f"La bonne réponse était {bonne}."
