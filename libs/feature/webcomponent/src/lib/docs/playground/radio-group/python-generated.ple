sandbox = "python"

qcm = :wc-radio-group
qcm.horizontal = true

builder == #!lang=py
import random

random.seed(seed)
a = random.randint(3, 12)
b = random.randint(3, 12)
bonne = a * b

# Distracteurs plausibles, sans doublon.
propositions = {bonne, bonne + a, bonne - b, a + b}
while len(propositions) < 4:
    propositions.add(bonne + random.randint(1, 9))
propositions = list(propositions)
random.shuffle(propositions)

# Les propositions sont des chaînes : qcm["selection"] contiendra le texte choisi.
qcm["items"] = [str(p) for p in propositions]
==

title ==
QCM généré en Python
