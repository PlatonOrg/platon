sandbox = "node"

// wc-code-viewer affiche du code en lecture seule, avec coloration et lignes surlignées.
programme = :wc-code-viewer
programme.language = "python"
programme.highlights = "3-4"
programme.lines = "1"

reponse = :wc-input-box
reponse.type = "number"

builder == #!lang=js
n = 3 + Math.floor(Math.random() * 4)
pas = 1 + Math.floor(Math.random() * 3)
programme.code = [
  'total = 0',
  `for i in range(${n}):`,
  `    total = total + i * ${pas}`,
  '    print(total)',
  'print("fin")'
].join('\n')

resultat = 0
for (let i = 0; i < n; i++) resultat += i * pas
==

title ==
Exécuter un programme à la main
==

statement ==
{{ programme }}

Quelle est la **dernière valeur numérique** affichée par ce programme ?
==

form ==
{{ reponse }}
==

grader == #!lang=js
if (Number(reponse.value) === resultat) {
  grade = 100
  feedback.type = 'success'
  feedback.content = 'Exact !'
} else {
  grade = 0
  feedback.type = 'error'
  feedback.content = 'Suivez la valeur de total à chaque tour de boucle (lignes surlignées).'
}
==

solution ==
La boucle s'exécute pour i allant de 0 à {{ n - 1 }} : la dernière valeur affichée est {{ resultat }}.
==
