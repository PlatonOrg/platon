sandbox = "node"

// wc-evaluator affiche une note sous forme d'icônes (étoiles par défaut).
note = :wc-evaluator
note.title = "Votre niveau de confiance"
note.count = 5
note.tooltips = ["Pas du tout", "Un peu", "Moyennement", "Plutôt bien", "Parfaitement"]

title ==
Auto-évaluation
==

statement ==
Avant de passer à la suite, indiquez à quel point vous vous sentez à l'aise avec les boucles `for`.
==

form ==
{{ note }}
==

grader == #!lang=js
// Il n'y a pas de bonne réponse : on valide dès qu'une note est donnée
// et on adapte le message à la réponse.
if (!note.value) {
  grade = -2 // Donner une note inférieure à 0 permet de ne pas compter la soumission comme une tentative.
  feedback.type = 'warning'
  feedback.content = 'Choisissez un nombre d\'étoiles avant de valider.'
} else {
  grade = 100
  feedback.type = 'info'
  feedback.content = note.value <= 2
    ? 'Merci ! Nous vous conseillons de relire le cours sur les boucles avant de continuer.'
    : 'Merci ! Vous pouvez passer aux exercices suivants.'
}
==
