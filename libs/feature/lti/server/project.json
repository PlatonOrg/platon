{
  "name": "feature-lti-server",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feature/lti/server/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/feature/lti/server/jest.config.ts"
      }
    },
    "test:integration": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/integration"],
      "options": {
        "jestConfig": "libs/feature/lti/server/jest.integration.config.ts",
        "passWithNoTests": false
      }
    },
    "test:all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run feature-lti-server:test", "nx run feature-lti-server:test:integration"],
        "parallel": false
      }
    }
  }
}
